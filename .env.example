# Endpoint the fleet and feedback forms POST to (JSON body).
# Unset, both forms fail gracefully and point the visitor at the phone and email.
NEXT_PUBLIC_LEAD_WEBHOOK=https://api.web3forms.com/submit

# Web3Forms access key identifying the destination inbox. Public by design —
# it is sent from the browser — but keep it out of the repo so it can be
# rotated without a code change. Leave unset for providers that need no key.
NEXT_PUBLIC_LEAD_ACCESS_KEY=
